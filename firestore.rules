rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Red-Team-Grade Security
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidManuscript(data) {
      return data.keys().hasAll(['title', 'ownerId', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 250
        && data.ownerId == request.auth.uid
        && (!('content' in data) || (data.content is string && data.content.size() <= 500000))
        && (!('genre' in data) || (data.genre is string && data.genre.size() <= 100))
        && (!('isConfidential' in data) || data.isConfidential is bool)
        && (!('encryptionAlgo' in data) || data.encryptionAlgo is string);
    }
    
    function isValidChatMessage(data) {
      return data.keys().hasAll(['sessionId', 'role', 'text', 'timestamp'])
        && data.role in ['user', 'assistant', 'system']
        && data.text is string
        && data.text.size() <= 100000
        && data.sessionId is string
        && data.sessionId.size() <= 128;
    }

    // 1. Author User Profiles (Strictly Isolated)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Author Manuscripts & Drafts (Strictly Isolated, Zero Public Leaks)
    match /manuscripts/{manuscriptId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && isValidManuscript(request.resource.data);
      allow update: if isAuthenticated() 
                    && resource.data.ownerId == request.auth.uid 
                    && isValidManuscript(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId; // Prevents ownership reassignment
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      // Chapters subcollection
      match /chapters/{chapterId} {
        allow read, write: if isAuthenticated() 
          && get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data.ownerId == request.auth.uid;
      }
    }

    // 3. Confidential Chat History & Neural Sessions
    match /chat_sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.ownerId == request.auth.uid;
      }
    }

    // 4. Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
